{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.0",
        "endroid/qr-code": "^5.1",
        "google/apiclient": "^2.0",
        "guzzlehttp/guzzle": "^7.2",
        "jeroennoten/laravel-adminlte": "^3.15",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.40",
        "laravel/reverb": "^1.6",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.8",
        "livewire/livewire": "^4.0",
        "masbug/flysystem-google-drive-ext": "^2.4",
        "phpoffice/phpspreadsheet": "^2.2",
        "picqer/php-barcode-generator": "^3.2",
        "predis/predis": "^3.2",
        "pusher/pusher-php-server": "^7.2",
        "setasign/fpdi": "^2.6",
        "spatie/laravel-permission": "^6.4",
        "symfony/var-dumper": "^7.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16",
        "deptrac/deptrac": "^4.6",
        "fakerphp/faker": "^1.9.1",
        "larastan/larastan": "^3.10",
        "laravel/boost": "^1.8",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.5",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "deptrac": "vendor/bin/deptrac analyse --no-progress",
        "rector:dry-run": "vendor/bin/rector process --dry-run",
        "rector:inventario": "vendor/bin/rector process app/Inventario",
        "rector:complementarios": "vendor/bin/rector process app/Services/Complementarios app/Repositories/Complementarios app/Http/Controllers/Complementarios app/Models/Complementarios",
        "rector:asistencias": "vendor/bin/rector process app/Http/Controllers/AsistenceQrController.php app/Http/Controllers/RegistroAsistenciaController.php app/Http/Controllers/AsistenciaConsultaController.php app/Http/Controllers/AsistenciaAprendicesController.php app/Services/AsistenciaService.php app/Services/AsistenceQrService.php",
        "rector:seeders": "vendor/bin/rector process database/seeders/PaisSeeder.php database/seeders/ParametroSeeder.php database/seeders/SedeSeeder.php database/seeders/DepartamentoSeeder.php database/seeders/CentroFormacionSeeder.php database/seeders/ProductoSeeder.php database/seeders/RolePermissionSeeder.php database/seeders/TemaSeeder.php database/seeders/ComplementariosSeeder.php database/seeders/PisoSeeder.php database/seeders/BloqueSeeder.php database/seeders/RegionalSeeder.php database/seeders/TestingSeeder.php database/seeders/DatabaseSeeder.php database/seeders/ComplementariosAvanzadoSeeder.php"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false,
        "platform": {
            "php": "8.3.32",
            "ext-pcntl": "1.0",
            "ext-posix": "1.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
